.DS_Store
.gstack/*
!.gstack/

# Generated opportunity runs are resumable working state, not durable publications.
runs/

# Publication lock state is mechanical; published outcome contents stay tracked.
outcomes/.publish.lock

# Local browser and Python runtime state.
.playwright-cli/
browser*.log
browse*.log
playwright*.log
**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage
